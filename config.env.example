# Site configuration for research-template. Copy to config.env (git-ignored) next to this file, on the
# laptop and on the cluster, and fill in your own values. new_project.sh and cluster_setup.sh read it.
CLUSTER_HOST=login.cluster.example.edu     # ssh host of the login node (only used in CLAUDE.md text)
SLURM_ACCOUNT=myaccount                     # sbatch -A
SLURM_PARTITION=gpu                         # sinfo -p, for scripts/gpus.sh
SCRATCH=/scratch/myaccount/myuser           # absolute path; projects, caches, envs and tools live under it
CONDA_ROOT=~/miniforge3                     # conda install; ~ is fine
CONDA_ENV=research                          # default project env (torch, transformers, ...)
GITHUB_USER=myuser                          # project repos are cloned from git@github.com:$GITHUB_USER/<name>
TUNNEL_PREFIX=nb                            # tunnel name becomes <prefix>-<node number>
GPU_CAP=4                                   # cards you may hold at once
